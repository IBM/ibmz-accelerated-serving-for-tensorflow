# Usage:
#   docker build --build-arg BASE_IMAGE=<image> -t ccf-serving-sample .
#
# BASE_IMAGE must be an IBM Z Accelerated for TensorFlow production image, e.g.:
#   icr.io/ibmz/ibmz-accelerated-for-tensorflow:1.6.0
#
# Note: this image is used to run the deployment and inference scripts only.
# The TensorFlow Serving container is run separately — see README.md.

ARG BASE_IMAGE
FROM ${BASE_IMAGE}

# Switch to root to install system build dependencies
USER root

RUN dnf install -y \
        gcc \
        gcc-c++ \
        gcc-gfortran \
        ninja-build \
        python3-devel \
        openblas-devel \
    && dnf clean all

# Install Python build tools (required to build scipy and scikit-learn from source on s390x)
RUN /opt/venv/bin/pip install --no-cache-dir \
        "meson>=1.5.0" \
        meson-python \
        pythran \
        "pybind11>=2.13.2" \
        cython

# Build and install scipy and scikit-learn from source
RUN PATH="/opt/venv/bin:${PATH}" /opt/venv/bin/pip install --no-cache-dir --no-build-isolation scipy
RUN PATH="/opt/venv/bin:${PATH}" /opt/venv/bin/pip install --no-cache-dir --no-build-isolation "scikit-learn==1.8.0"

# Install remaining Python dependencies
# versioneer must be pre-installed before pandas when using --no-build-isolation
RUN /opt/venv/bin/pip install --no-cache-dir "versioneer[toml]"
RUN PATH="/opt/venv/bin:${PATH}" /opt/venv/bin/pip install --no-cache-dir --no-build-isolation "pandas>=3.0.5" joblib

# Install TensorFlow Serving API for deployment and inference scripts
RUN /opt/venv/bin/pip install --no-cache-dir tensorflow-serving-api

# Drop back to non-root user for runtime
USER ibm-user
